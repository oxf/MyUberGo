meta {
  name: Get Driver Shift List
  type: http
  seq: 7
}

get {
  url: http://localhost:8090/api/driver/driver-shift?page=1&pageSize=20&sortBy=startedAt&sortDir=desc
  body: json
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  sortBy: startedAt
  sortDir: desc
}

headers {
  Authorization: Bearer {{admin_auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
