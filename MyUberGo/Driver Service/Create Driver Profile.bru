meta {
  name: Create Driver Profile
  type: http
  seq: 1
}

post {
  url: http://localhost:8003/driver-profile
  body: json
  auth: inherit
}

headers {
  X-User-Id: c5f313c0-9ca2-400e-b231-ddacbc579546
}

body:json {
  {
    "userId": "c5f313c0-9ca2-400e-b231-ddacbc579546",
    "driverName": "Bob Driver",
    "phone": "+1223456",
    "vehicleType": "Mercedes S class",
    "licencePlate": "ABC123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
