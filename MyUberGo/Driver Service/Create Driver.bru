meta {
  name: Create Driver
  type: http
  seq: 1
}

post {
  url: http://localhost:8090/api/driver/driver
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
}

body:json {
  {
    "userId": "c5f313c0-9ca2-400e-b231-ddacbc579546",
    "vehicleType": "Mercedes S class",
    "licencePlate": "ABC123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
