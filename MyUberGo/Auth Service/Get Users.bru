meta {
  name: Get Users
  type: http
  seq: 5
}

get {
  url: http://localhost:8090/api/auth/users?page=1&pageSize=20&sortBy=createdAt&sortDir=desc
  body: json
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  sortBy: createdAt
  sortDir: desc
}

headers {
  Authorization: Bearer {{admin_auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
