meta {
  name: Get Ride List
  type: http
  seq: 2
}

get {
  url: http://localhost:8090/api/ride/ride?page=1&pageSize=20&sortBy=createdAt&sortDir=desc
  body: json
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  sortBy: createdAt
  sortDir: desc
}

headers {
  Authorization: Bearer {{auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
